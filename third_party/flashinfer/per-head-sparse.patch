+import pytest
+import torch
+
+import flashinfer
+from flashinfer.per_head_bsaw import PerHeadBlockSparseAttentionWrapper
+
+
+def _mask_to_csr(mask: torch.Tensor) -> tuple[list[torch.Tensor], list[torch.Tensor]]:
+    indptr_per_head: list[torch.Tensor] = []
+    indices_per_head: list[torch.Tensor] = []
+    for head_idx in range(mask.shape[0]):
+        head_mask = mask[head_idx]
+        row_counts = head_mask.sum(dim=1, dtype=torch.int32)
+        indptr = torch.zeros(
+            head_mask.shape[0] + 1,
+            dtype=torch.int32,
+            device=head_mask.device,
+        )
+        indptr[1:] = torch.cumsum(row_counts, dim=0)
+        indices = torch.nonzero(head_mask, as_tuple=False)[:, 1].to(torch.int32).contiguous()
+        indptr_per_head.append(indptr)
+        indices_per_head.append(indices)
+    return indptr_per_head, indices_per_head
+
+
+def _reference(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    mask: torch.Tensor,
+    block_size: int,
+) -> torch.Tensor:
+    num_kv_heads = k.shape[1]
+    group_size = q.shape[1] // num_kv_heads
+    outputs = []
+    for head_idx in range(num_kv_heads):
+        dense_mask = mask[head_idx].repeat_interleave(block_size, dim=0).repeat_interleave(block_size, dim=1)
+        outputs.append(
+            flashinfer.single_prefill_with_kv_cache(
+                q[:, head_idx * group_size : (head_idx + 1) * group_size, :].contiguous(),
+                k[:, head_idx : head_idx + 1, :].contiguous(),
+                v[:, head_idx : head_idx + 1, :].contiguous(),
+                custom_mask=dense_mask,
+            )
+        )
+    return torch.cat(outputs, dim=1)
+
+
+@pytest.mark.parametrize("num_kv_heads,group_size", [(1, 1), (2, 2)])
+def test_per_head_bsaw_matches_reference(num_kv_heads: int, group_size: int):
+    torch.manual_seed(7)
+    device = "cuda"
+    block_size = 128
+    seq_len = 256
+    head_dim = 128
+    num_qo_heads = num_kv_heads * group_size
+
+    mask = torch.tensor(
+        [
+            [[1, 1], [0, 1]],
+            [[1, 0], [1, 1]],
+        ][:num_kv_heads],
+        dtype=torch.bool,
+        device=device,
+    )
+    indptr_per_head, indices_per_head = _mask_to_csr(mask)
+
+    q = torch.randn(seq_len, num_qo_heads, head_dim, dtype=torch.float16, device=device)
+    k = torch.randn(seq_len, num_kv_heads, head_dim, dtype=torch.float16, device=device)
+    v = torch.randn(seq_len, num_kv_heads, head_dim, dtype=torch.float16, device=device)
+    workspace = torch.empty(128 * 1024 * 1024, dtype=torch.uint8, device=device)
+
+    reference = _reference(q, k, v, mask, block_size)
+
+    concurrent = PerHeadBlockSparseAttentionWrapper(workspace)
+    concurrent.plan(
+        indptr_per_head,
+        indices_per_head,
+        seq_len,
+        seq_len,
+        block_size,
+        block_size,
+        num_qo_heads,
+        num_kv_heads,
+        head_dim,
+        q_data_type=q.dtype,
+        kv_data_type=k.dtype,
+        o_data_type=q.dtype,
+    )
+    torch.testing.assert_close(concurrent.run(q, k, v), reference, atol=1e-2, rtol=1e-2)
+
+    sequential = PerHeadBlockSparseAttentionWrapper(workspace)
+    sequential.plan(
+        indptr_per_head,
+        indices_per_head,
+        seq_len,
+        seq_len,
+        block_size,
+        block_size,
+        num_qo_heads,
+        num_kv_heads,
+        head_dim,
+        sequential_heads=True,
+        q_data_type=q.dtype,
+        kv_data_type=k.dtype,
+        o_data_type=q.dtype,
+    )
+    torch.testing.assert_close(sequential.run(q, k, v), reference, atol=1e-2, rtol=1e-2)
+
+
+def test_per_head_bsaw_rejects_unimplemented_modes():
+    device = "cuda"
+    workspace = torch.empty(128 * 1024 * 1024, dtype=torch.uint8, device=device)
+    indptr = [torch.tensor([0, 1], dtype=torch.int32, device=device)]
+    indices = [torch.tensor([0], dtype=torch.int32, device=device)]
+    wrapper = PerHeadBlockSparseAttentionWrapper(workspace)
+
+    with pytest.raises(NotImplementedError, match="causal=True"):
+        wrapper.plan(indptr, indices, 128, 128, 128, 128, 1, 1, 128, causal=True)
+    with pytest.raises(NotImplementedError, match="row reordering"):
+        wrapper.plan(
+            indptr,
+            indices,
+            128,
+            128,
+            128,
+            128,
+            1,
+            1,
+            128,
+            row_perm_per_head=[torch.tensor([0], dtype=torch.int32, device=device)],
+        )
+    with pytest.raises(NotImplementedError, match="internal row reorder"):
+        wrapper.plan(indptr, indices, 128, 128, 128, 128, 1, 1, 128, reorder_algo="nnz")
